rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Explicitly deny default access
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }

    // Public Read-Only Collections / Docs
    match /meta/personalInfoPublic {
        allow read: if true;
        allow write: if false;
    }
    match /meta/elixiaryVenture {
        allow read: if true;
        allow write: if false;
    }
    match /experiences/{docId} {
        allow read: if true;
        allow write: if false;
    }
    match /projects/{docId} {
        allow read: if true;
        allow write: if false;
    }
    match /education/{docId} {
        allow read: if true;
        allow write: if false;
    }
    match /certifications/{docId} {
        allow read: if true;
        allow write: if false;
    }
    match /skills/{docId} {
        allow read: if true;
        allow write: if false;
    }

    // Private contact details (admin/backend only via Admin SDK + IAM)
    match /privateMeta/{docId} {
      allow read, write: if false;
    }

    // Contact Form Inquiries (client can create only; no Functions required)
    // Strict validation on create. No read/update/delete from client.
    match /inquiries/{docId} {
      allow read, update, delete: if false;
      allow create: if request.auth == null
        && request.resource.data.keys().hasAll(['name', 'email', 'message', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 254
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 5000
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly(['name', 'email', 'message', 'createdAt']);
    }

    // Intake rate-limit buckets (backend only)
    match /intakeRateLimits/{docId} {
      allow read, write: if false;
    }
  }
}
