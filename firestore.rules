rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Explicitly deny default access
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }

    // Public Read-Only Collections
    match /meta/{docId} {
        allow read: if true;
        allow write: if false;
    }
    match /experiences/{docId} {
        allow read: if true;
        allow write: if false;
    }
    match /projects/{docId} {
        allow read: if true;
        allow write: if false;
    }
    match /education/{docId} {
        allow read: if true;
        allow write: if false;
    }
    match /certifications/{docId} {
        allow read: if true;
        allow write: if false;
    }
    match /skills/{docId} {
        allow read: if true;
        allow write: if false;
    }

    // Contact Form Inquiries
    // Client SDK writes are blocked. Only trusted backend identities (Cloud Functions / service accounts)
    // can write via Firebase Admin SDK, which bypasses Firestore rules and is enforced through IAM.
    match /inquiries/{docId} {
      allow read: if false;
      allow create, update, delete: if false;
    }

    // Intake rate-limit buckets (backend only)
    match /intakeRateLimits/{docId} {
      allow read, write: if false;
    }
  }
}
